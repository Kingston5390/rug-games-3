\u0438\\u043a\\u043e\\u044e CORS. \\u042f\\u043a\\u0449\\u043e \\u0432\\u0438 \\u0430\\u0434\\u043c\\u0456\\u043d\\u0456\\u0441\\u0442\\u0440\\u0430\\u0442\\u043e\\u0440 \\u0441\\u0435\\u0440\\u0432\\u0435\\u0440\\u0430, \\u0437\\u0432\\u0435\\u0440\\u043d\\u0456\\u0442\\u044c\\u0441\\u044f \\u0434\\u043e Ruffle Wiki, \\u0449\\u043e\\u0431 \\u043e\\u0442\\u0440\\u0438\\u043c\\u0430\\u0442\\u0438 \\u0434\\u043e\\u043f\\u043e\\u043c\\u043e\\u0433\\u0443.\\nerror-wasm-cors = Ruffle \\u043d\\u0435 \\u0432\\u0434\\u0430\\u043b\\u043e\\u0441\\u044f \\u0437\\u0430\\u0432\\u0430\\u043d\\u0442\\u0430\\u0436\\u0438\\u0442\\u0438 \\u043d\\u0435\\u043e\\u0431\\u0445\\u0456\\u0434\\u043d\\u0438\\u0439 \\u0444\\u0430\\u0439\\u043b\\u043e\\u0432\\u0438\\u0439 \\u043a\\u043e\\u043c\\u043f\\u043e\\u043d\\u0435\\u043d\\u0442 \".wasm\". \\u041c\\u043e\\u0436\\u043b\\u0438\\u0432\\u043e, \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f \\u0434\\u043e \\u043e\\u0442\\u0440\\u0438\\u043c\\u0430\\u043d\\u043d\\u044f \\u0431\\u0443\\u043b\\u043e \\u0437\\u0430\\u0431\\u043b\\u043e\\u043a\\u043e\\u0432\\u0430\\u043d\\u043e \\u043f\\u043e\\u043b\\u0456\\u0442\\u0438\\u043a\\u043e\\u044e CORS. \\u042f\\u043a\\u0449\\u043e \\u0432\\u0438 \\u0430\\u0434\\u043c\\u0456\\u043d\\u0456\\u0441\\u0442\\u0440\\u0430\\u0442\\u043e\\u0440 \\u0441\\u0435\\u0440\\u0432\\u0435\\u0440\\u0430, \\u0437\\u0432\\u0435\\u0440\\u043d\\u0456\\u0442\\u044c\\u0441\\u044f \\u0434\\u043e Ruffle Wiki, \\u0449\\u043e\\u0431 \\u043e\\u0442\\u0440\\u0438\\u043c\\u0430\\u0442\\u0438 \\u0434\\u043e\\u043f\\u043e\\u043c\\u043e\\u0433\\u0443.\\nerror-wasm-invalid = Ruffle \\u0437\\u0456\\u0442\\u043a\\u043d\\u0443\\u0432\\u0441\\u044f \\u0437 \\u0441\\u0435\\u0440\\u0439\\u043e\\u0437\\u043d\\u043e\\u044e \\u043f\\u0440\\u043e\\u0431\\u043b\\u0435\\u043c\\u043e\\u044e \\u043f\\u0456\\u0434 \\u0447\\u0430\\u0441 \\u0441\\u043f\\u0440\\u043e\\u0431\\u0438 \\u0456\\u043d\\u0456\\u0446\\u0456\\u0430\\u043b\\u0456\\u0437\\u0430\\u0446\\u